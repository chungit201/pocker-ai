# Copy to .env.local and edit.
#
# Two gateways are in play. The deployed one is
# https://api.bloomcapital.market, which is what .env.local points at and what
# the values below are written for. The other is the same code run locally —
# C:\projects\Poker-BE (npm start, needs Postgres) — on port 3000, which is why
# this app runs on 3001.
#
# For the deployed gateway:
#   NEXT_PUBLIC_SUITED_WS=wss://api.bloomcapital.market
#   SUITED_BACKEND=https://api.bloomcapital.market
# Verified with `node tools/probe-gateway.mjs` and `node tools/probe-live.mjs`;
# see docs/gateway.md for what that deployment does and does not serve.

# ── where the gateway is ─────────────────────────────────────────────────────
# unset      use this page's own origin. /api reaches the gateway through the
#            rewrite in next.config.ts, so the gateway needs no CORS — which it
#            has none of. This is the setting for normal work.
# null       offline demo: bots in the browser, a local RNG, no gateway and no
#            Postgres. How the original index.html shipped, and the quickest way
#            to see the UI without standing up a database.
# https://…  a gateway on some other origin. Needs CORS on the gateway, which
#            it does not currently send — prefer the rewrite.
NEXT_PUBLIC_SUITED_SERVER=

# The WebSocket endpoint, which deliberately does NOT follow the setting above.
# A Next rewrite carries no WebSocket upgrade, so REST is proxied and the socket
# is dialled straight at the gateway. WebSocket is not subject to CORS, so this
# needs nothing from the gateway. Leave unset when something in front of both
# serves them on one origin.
NEXT_PUBLIC_SUITED_WS=ws://localhost:3000

# Forces the local bot table even when a gateway is configured.
NEXT_PUBLIC_SUITED_OFFLINE=

# ── wallets ──────────────────────────────────────────────────────────────────
# See docs/wallet-sign-in.md.
#
# The EVM chain the gateway expects. Defaults match Poker-BE's own config —
# Robinhood Chain Testnet. Keep the two in step or a wallet will be asked to
# switch to a chain the gateway does not recognise.
NEXT_PUBLIC_CHAIN_ID=46630
NEXT_PUBLIC_CHAIN_RPC_URL=https://rpc.testnet.chain.robinhood.com
NEXT_PUBLIC_CHAIN_EXPLORER_URL=

# Which Solana cluster to read balances from. Sign-in itself touches no RPC.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# WalletConnect project id, from https://dashboard.reown.com. Optional: the app
# carries one of its own (src/wallet/Providers.tsx), so leave this empty unless
# a deployment has a project of its own — in which case this one wins. Either
# way the deployed domain has to be on that project's allowed list.
NEXT_PUBLIC_WALLETCONNECT_ID=

# ── server side ──────────────────────────────────────────────────────────────
# Where next.config.ts points the /api and /dev rewrites.
SUITED_BACKEND=http://localhost:3000

# ── a note on the gateway's own settings ─────────────────────────────────────
# Poker-BE rate-limits per client IP (api 300/min, auth 30/min, ws-connect
# 30/min). Behind this rewrite it sees whichever address the request arrives
# from, so in production put Next and the gateway behind one reverse proxy that
# sets x-forwarded-for — Next passes that header through — and start the gateway
# with TRUST_PROXY=1. Without it every player shares one bucket and they
# throttle each other. Locally it changes nothing: every client is 127.0.0.1.
